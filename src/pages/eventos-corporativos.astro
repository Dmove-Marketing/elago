---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import '../styles/eventos-corporativos.css';
const webhookUrl = (config.forms as any)['lead-form-eventos'].webhooks[0];
---

<Base
  title="Eventos Corporativos em Cedral | Elago"
  description="Complexo de eventos em Cedral (SP) com salão para até 1.100 pessoas, área externa, varanda gourmet, casa exclusiva, lago e bosque. Solicite um orçamento para o evento da sua empresa."
  ogImage="/imagens/elago-corporativo-hero.jpg"
  canonical="https://elago.com.br/eventos-corporativos"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#1E3700" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/cwh2gwf.css" />
  </Fragment>

<!-- ===================== HEADER ===================== -->
<header class="site-header" id="cabecalho">
  <div class="wrap">
    <a class="logo" href="#topo" aria-label="Elago — voltar ao topo">
      <img src="/imagens/elago-logo.svg" alt="Elago" width="101" height="40">
    </a>
  </div>
</header>

<main>

<!-- ===================== HERO ===================== -->
<section class="hero" id="topo">
  <div class="midia-fundo">
    <img src="/imagens/elago-corporativo-hero.jpg" alt="Vista aérea noturna do complexo Elago, com salão, piscina e áreas verdes em Cedral (SP)" width="2400" height="1350" fetchpriority="high">
  </div>
  <div class="wrap conteudo-hero">
    <p class="sobretitulo">Eventos corporativos <span aria-hidden="true"></span> Cedral</p>
    <h1>Natureza e versatilidade <br class="quebra-desktop">para encontros que vão <span class="destaque">além da sala de reunião</span></h1>
    <a class="btn btn-claro" href="#contato">Solicite orçamento</a>
  </div>
</section>

<!-- ===================== AUTORIDADE ===================== -->
<section class="autoridade" id="autoridade" aria-label="Destaques do Elago">
  <div class="wrap">
    <ul>
      <li style="--i:0"><span>De <strong><span class="contador" data-alvo="250">250</span> a <span class="contador" data-alvo="1100">1.100</span></strong> convidados</span></li>
      <li style="--i:1"><span>Estrutura versátil</span></li>
      <li style="--i:2"><span>Integração com a natureza</span></li>
    </ul>
  </div>
</section>

<!-- ===================== CONCEITO ===================== -->
<section class="secao conceito" id="conceito">
  <div class="wrap grid-conceito">
    <div class="texto-conceito reveal">
      <span class="rotulo">Conceito</span>
      <h2 class="titulo-secao">Mais possibilidades para a agenda da sua empresa</h2>
      <p>No Elago, o espaço acompanha a proposta do evento. O complexo reúne salão principal, área externa, área gourmet, piscina, lago e bosque, permitindo diferentes configurações para encontros corporativos, confraternizações, lançamentos, feiras, congressos, treinamentos e outros formatos.</p>
    </div>
    <div class="moldura-video reveal" data-atraso="1">
      <div class="video-arco">
        <video id="video-conceito" autoplay muted loop playsinline preload="metadata" poster="/imagens/elago-conceito-poster.jpg" aria-label="Vídeo institucional do Elago: fachada, salão, lago e áreas externas">
          <source src="/videos/elago-corporativo-conceito.mp4" type="video/mp4">
        </video>
        <button class="btn-som" type="button" aria-pressed="false" aria-label="Ativar som do vídeo">
          <svg class="ico-off" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.7.7 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.7.7 0 0 0 11 19.298z"/><path d="m16.5 14.5 5-5"/><path d="m16.5 9.5 5 5"/></svg>
          <svg class="ico-on" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/></svg>
          <span class="txt-som">Ativar som</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ===================== ESPAÇOS ===================== -->
<section class="secao espacos escuro" id="espacos">
  <div class="wrap">
    <div class="cabecalho-secao reveal">
      <span class="rotulo">Espaços</span>
      <h2 class="titulo-secao"><span>Diferentes ambientes.</span> <span class="destaque">Uma estrutura que se adapta.</span></h2>
    </div>

    <div class="grid-espacos">
      <article class="espaco reveal">
        <div class="arco"><img src="/imagens/elago-espaco-salao-principal.jpg" alt="Salão principal do Elago, amplo, com colunas e janelas em arco" width="1600" height="1067" loading="lazy" style="object-position:50% 50%"></div>
        <div class="numero">01</div>
        <h3>Salão principal</h3>
        <p>Com capacidade para até 600 pessoas sentadas ou 1.100 em pé, o salão oferece amplitude para diferentes formatos e configurações de eventos corporativos.</p>
      </article>
      <article class="espaco reveal" data-atraso="1">
        <div class="arco"><img src="/imagens/elago-espaco-area-externa.jpg" alt="Área externa do Elago com fachada em arcos e piso de pedra ao entardecer" width="1600" height="1200" loading="lazy" style="object-position:62% 50%"></div>
        <div class="numero">02</div>
        <h3>Área externa</h3>
        <p>Integrada ao entorno natural e com capacidade para até 250 pessoas, é uma alternativa para recepções, confraternizações, encontros e eventos que pedem uma atmosfera mais aberta.</p>
      </article>
      <article class="espaco reveal" data-atraso="2">
        <div class="arco"><img src="/imagens/elago-espaco-varanda-gourmet.jpg" alt="Varanda gourmet do Elago com piscina iluminada e espreguiçadeiras" width="1600" height="1067" loading="lazy" style="object-position:58% 50%"></div>
        <div class="numero">03</div>
        <h3>Varanda gourmet</h3>
        <p>Um ambiente que pode ser contratado de forma independente ou integrado ao complexo, ampliando as possibilidades de configuração do evento.</p>
      </article>
      <article class="espaco reveal" data-atraso="3">
        <div class="arco"><img src="/imagens/elago-espaco-casa-exclusiva.jpg" alt="Sala de estar da casa exclusiva do Elago, com mezanino e janelas para o jardim" width="1600" height="1067" loading="lazy" style="object-position:38% 50%"></div>
        <div class="numero">04</div>
        <h3>Casa exclusiva</h3>
        <p>Espaço reservado para encontros corporativos que valorizam privacidade, conforto e uma experiência diferenciada.</p>
      </article>
    </div>
    <p class="dica-arraste" aria-hidden="true">Arraste para ver os ambientes</p>
  </div>
</section>

<!-- ===================== EVENTOS ===================== -->
<section class="secao eventos" id="eventos">
  <div class="wrap">
    <div class="cabecalho-secao reveal">
      <span class="rotulo">Eventos</span>
      <h2 class="titulo-secao">Versatilidade para diferentes objetivos corporativos</h2>
    </div>
    <ul class="grid-eventos">
      <li class="evento reveal">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09"/><path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05"/></svg></span>
        <span>Lançamentos de produtos</span>
      </li>
      <li class="evento reveal" data-atraso="1">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"/><path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"/><path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"/></svg></span>
        <span>Feiras</span>
      </li>
      <li class="evento reveal" data-atraso="2">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 13h4a2 2 0 0 0 1.901-1.38l1.057-4.333A1 1 0 0 0 21 6H3a1 1 0 0 0-.958 1.287L3.1 11.621A2 2 0 0 0 5.001 13h4"/><path d="M15 22V11a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v11"/><path d="M18 22H6"/><path d="M18 6V3a1 1 0 0 0-1-1h-3"/></svg></span>
        <span>Congressos</span>
      </li>
      <li class="evento reveal" data-atraso="3">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22h8"/><path d="M7 10h10"/><path d="M12 15v7"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/></svg></span>
        <span>Confraternizações</span>
      </li>
      <li class="evento reveal">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg></span>
        <span>Workshops e treinamentos</span>
      </li>
      <li class="evento reveal" data-atraso="1">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg></span>
        <span>Eventos de relacionamento</span>
      </li>
      <li class="evento reveal" data-atraso="2">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"/><path d="M8 6v8"/></svg></span>
        <span>Ativações de marca</span>
      </li>
      <li class="evento reveal" data-atraso="3">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3"/><path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4"/><path d="M5 21h14"/></svg></span>
        <span>Atividades e eventos wellness</span>
      </li>
    </ul>
  </div>
</section>

<!-- ===================== CLIENTES ===================== -->
<section class="secao clientes" id="clientes">
  <div class="wrap">
    <div class="cabecalho-secao reveal">
      <span class="rotulo">Clientes</span>
      <h2 class="titulo-secao">Conheça as grandes marcas que já passaram por aqui</h2>
    </div>
    <div class="logos-trilho reveal" data-atraso="1">
      <div class="logos-faixa">
        <ul class="logos-clientes">
      <li><img class="logo-largo" src="/imagens/elago-cliente-tereos.png" alt="Tereos" width="873" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-ram.png" alt="RAM" width="221" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-lukma.png" alt="Grupo Lukma Electric" width="811" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-rcb.png" alt="Rio Preto Country Bulls" width="260" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-kelvin.png" alt="Kelvin Sistema de Ensino" width="298" height="98" loading="lazy"></li>
    </ul>
        <ul class="logos-clientes" aria-hidden="true">
      <li><img class="logo-largo" src="/imagens/elago-cliente-tereos.png" alt="" width="873" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-ram.png" alt="" width="221" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-lukma.png" alt="" width="811" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-rcb.png" alt="" width="260" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-kelvin.png" alt="" width="298" height="98" loading="lazy"></li>
    </ul>
        <ul class="logos-clientes" aria-hidden="true">
      <li><img class="logo-largo" src="/imagens/elago-cliente-tereos.png" alt="" width="873" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-ram.png" alt="" width="221" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-lukma.png" alt="" width="811" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-rcb.png" alt="" width="260" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-kelvin.png" alt="" width="298" height="98" loading="lazy"></li>
    </ul>
        <ul class="logos-clientes" aria-hidden="true">
      <li><img class="logo-largo" src="/imagens/elago-cliente-tereos.png" alt="" width="873" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-ram.png" alt="" width="221" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-lukma.png" alt="" width="811" height="240" loading="lazy"></li>
      <li><img class="logo-alto" src="/imagens/elago-cliente-rcb.png" alt="" width="260" height="240" loading="lazy"></li>
      <li><img class="logo-largo" src="/imagens/elago-cliente-kelvin.png" alt="" width="298" height="98" loading="lazy"></li>
    </ul>
      </div>
    </div>
  </div>
</section>

<!-- ===================== DEPOIMENTOS ===================== -->
<section class="secao depoimentos" id="depoimentos">
  <div class="wrap">
    <div class="topo-depoimentos">
      <div class="reveal">
        <span class="rotulo">Depoimentos</span>
        <h2 class="titulo-secao">O Elago pela experiência de quem esteve aqui</h2>
      </div>
      <a class="nota-google reveal" data-atraso="1" href="https://www.google.com/search?q=elago+eventos#lrd=0x94bc4b7722753c41:0xeb4dac9086f68dc4,1" target="_blank" rel="noopener">
        <span class="valor">4,9</span>
        <span class="detalhe">
          <span class="estrelas" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
