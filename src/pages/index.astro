</section>

<!-- FORMULÁRIO -->
<section id="formulario">
  <div class="form-wrap">
    <LeadForm
      formId="elago-contato"
      project={config.project_slug}
      submitUrl={config.forms['lead-form'].webhooks[0]}
      submitText="ENVIAR"
      prefix="elago"
      fields={getPreset(config.forms['lead-form'].preset) as any}
      successTitle="Mensagem enviada!"
      successText="Entraremos em contato em breve."
    />
  </div>
</section>

<!-- VOLTAR AO TOPO -->

<!-- FOOTER -->
<footer>
  <p>© 2026 Elago Eventos. Todos os direitos reservados</p>
</footer>

<script>
// Helper: get slide width in px — uses the first slide for accuracy
function slideW(container, slides) {
  const first = slides && slides[0];
  return first ? first.getBoundingClientRect().width : container.getBoundingClientRect().width;
}

// Salão carousel (autoplay + dash dots)
(function () {
  const track = document.getElementById('salaoTrack');
  const dotsEl = document.getElementById('salaoDots');
  const container = track && track.parentElement;
  if (!track || !dotsEl || !container) return;
  const slides = track.querySelectorAll('.salao-slide');
  const total = slides.length;
  if (total === 0) return;
  let cur = 0;
  let timer;

  const dots = [];
  for (let i = 0; i < total; i++) {
    const d = document.createElement('button');
    d.className = 'salao-dot' + (i === 0 ? ' active' : '');
    d.setAttribute('aria-label', 'Slide ' + (i + 1));
    d.addEventListener('click', function () { clearInterval(timer); goTo(i); startTimer(); });
    dotsEl.appendChild(d);
    dots.push(d);
  }

  function goTo(idx) {
    cur = (idx + total) % total;
    track.style.transform = 'translateX(-' + (cur * slideW(container, slides)) + 'px)';
    dots.forEach(function (d, i) { d.classList.toggle('active', i === cur); });
  }

  function startTimer() {
    timer = setInterval(function () { goTo(cur + 1); }, 4000);
  }

  startTimer();
})();

// Casa carousel (autoplay, no dots)
(function () {
  const track = document.getElementById('casaTrack');
  const container = track && track.parentElement;
  if (!track || !container) return;
  const slides = track.querySelectorAll('.casa-slide');
  const total = slides.length;
  if (total === 0) return;
  let cur = 0;

  setInterval(function () {
    cur = (cur + 1) % total;
    track.style.transform = 'translateX(-' + (cur * slideW(container, slides)) + 'px)';
  }, 4200);
})();

// Galeria slider
(function () {
  const track = document.getElementById('galTrack');
  const dotsEl = document.getElementById('galDots');
  const container = track && track.parentElement;
  if (!track || !dotsEl || !container) return;
  const slides = track.querySelectorAll('.gal-slide');
  const total = slides.length;
  if (total === 0) return;
  let cur = 0;
  let timer;

  const dots = [];
  for (let i = 0; i < total; i++) {
    const d = document.createElement('button');
    d.className = 'gal-dot' + (i === 0 ? ' active' : '');
    d.setAttribute('role', 'tab');
    d.setAttribute('aria-label', 'Foto ' + (i + 1));
    d.addEventListener('click', function () { clearInterval(timer); goTo(i); startTimer(); });
    dotsEl.appendChild(d);
    dots.push(d);
  }

  function goTo(idx) {
    cur = idx;
    track.style.transform = 'translateX(-' + (cur * slideW(container, slides)) + 'px)';
    dots.forEach(function (d, i) { d.classList.toggle('active', i === cur); });
  }

  function startTimer() {
    timer = setInterval(function () { goTo((cur + 1) % total); }, 4500);
  }

  document.getElementById('galPrev').addEventListener('click', function () {
    clearInterval(timer); goTo((cur - 1 + total) % total); startTimer();
  });
  document.getElementById('galNext').addEventListener('click', function () {
    clearInterval(timer); goTo((cur + 1) % total); startTimer();
  });

  startTimer();
})();

// Área carousel (Espaços)
(function () {
  const track = document.getElementById('areaTrack');
  const carousel = track && track.closest('.espacos-carousel');
  if (!track || !carousel) return;
  const slides = track.querySelectorAll('.area-slide');
  const total = slides.length;
  if (total === 0) return;
  let cur = 0;
  let timer;

  function goTo(idx) {
    cur = (idx + total) % total;
    const w = carousel.getBoundingClientRect().width;
    track.style.transform = 'translateX(-' + (cur * w) + 'px)';
  }

  function startTimer() { timer = setInterval(function () { goTo(cur + 1); }, 3200); }
  function resetTimer() { clearInterval(timer); startTimer(); }

  document.getElementById('areaPrev').addEventListener('click', function () { goTo(cur - 1); resetTimer(); });
  document.getElementById('areaNext').addEventListener('click', function () { goTo(cur + 1); resetTimer(); });

  // Swipe mobile
  let touchStartX = 0;
  carousel.addEventListener('touchstart', function (e) {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  carousel.addEventListener('touchend', function (e) {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) { goTo(diff > 0 ? cur + 1 : cur - 1); resetTimer(); }
  }, { passive: true });

  startTimer();
})();

// Principais Eventos — multi-item autoplay carousel
(function () {
  const wrap = document.querySelector('.eventos-wrap');
  const track = document.getElementById('eventosTrack');
  if (!track || !wrap) return;
  const cards = track.querySelectorAll('.evento-card');
  const total = cards.length;
  if (total === 0) return;
  let cur = 0;

  function getPerView() {
    if (window.innerWidth >= 992) return 4;
    if (window.innerWidth >= 576) return 2;
    return 1;
  }

  function advance() {
    const perView = getPerView();
    const maxPos = total - perView;
    cur = cur >= maxPos ? 0 : cur + 1;
    const cardWidth = cards[0].getBoundingClientRect().width;
    track.style.transform = 'translateX(-' + (cur * cardWidth) + 'px)';
  }

  setInterval(advance, 2800);
})();

// Botão WhatsApp no card de contato
(function () {
  const link = document.getElementById('contato-wpp-link');
  if (!link) return;
  link.addEventListener('click', function (e) {
    e.stopPropagation();
    document.getElementById('wa-toggle')?.click();
  });
})();


// Nav scroll highlight
(function () {
  const sectionIds = ['top', 'sobre', 'ambientes', 'diferenciais', 'galeria', 'contato'];
  const links = document.querySelectorAll('#main-nav a');
  function update() {
    const y = window.scrollY + 100;
    let active = 'top';
    for (let i = 0; i < sectionIds.length; i++) {
      const el = document.getElementById(sectionIds[i]);
      if (el && el.offsetTop <= y) active = sectionIds[i];
    }
    links.forEach(function (a) {
      const href = (a.getAttribute('href') || '').replace('#', '');
      a.classList.toggle('active', href === active);
    });
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

// Mobile menu toggle
(function () {
  const btn = document.getElementById('menuToggle');
  const nav = document.getElementById('main-nav');
  if (!btn || !nav) return;
  btn.addEventListener('click', function () {
    const open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
  nav.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    });
  });
})();

</script>

