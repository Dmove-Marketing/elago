---
import Base from '../layouts/Base.astro';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';
import config from '../../config.json';
import '../styles/eventos-corporativos.css';
import '../styles/eventos-sociais.css';
const webhookUrl = (config.forms as any)['lead-form-eventos'].webhooks[0];

/**
 * Imagens: o CDN é a fonte principal e a cópia local (public/imagens/sociais/) é o fallback.
 * Se o CDN falhar, o atributo onerror troca o src pela cópia local (uma única vez).
 */
const CDN = 'https://media.dmove.com.br/clients/elago/photos';
const LOCAL = '/imagens/sociais';
const onError = "this.onerror=null;this.src=this.dataset.fallback";
const foto = (cdnFile: string, localFile: string) => ({
  src: `${CDN}/${encodeURIComponent(cdnFile)}`,
  fallback: `${LOCAL}/${localFile}`,
});

const hero = foto('DJI_0584_EDITADA.webp', 'hero.webp');

type ItemGaleria = { cdn: string; local: string; alt: string; cls?: string; w: number; h: number };
// A ordem é a do layout (grid dense de 4 colunas): blocos de 2 linhas fechando 8 células cada.
const galeria: ItemGaleria[] = [
  { cdn: 'IMG_1396.webp',     local: 'IMG_1396.webp', cls: 'g-grande', w: 2048, h: 1365, alt: 'Palestra com convidados à mesa na varanda gourmet do Elago' },
  { cdn: 'IMG_0850.JPG.webp', local: 'IMG_0850.webp', cls: 'g-alta',   w: 1365, h: 2048, alt: 'Corredor de cerimônia decorado com flores brancas entre as árvores do Elago' },
  { cdn: 'IMG_0860.JPG.webp', local: 'IMG_0860.webp',                   w: 2048, h: 1365, alt: 'Salão do Elago decorado para casamento, com flores suspensas e iluminação cênica' },
  { cdn: 'IMG_0872.JPG.webp', local: 'IMG_0872.webp',                   w: 2048, h: 1365, alt: 'Cerimônia de casamento à beira do lago, com decoração branca e cadeiras de acrílico' },
  { cdn: 'IMG_3320.webp',     local: 'IMG_3320.webp', cls: 'g-alta',   w: 1365, h: 2048, alt: 'Área externa do Elago ao entardecer, com bar e convidados' },
  { cdn: 'IMG_0910.JPG.webp', local: 'IMG_0910.webp', cls: 'g-grande', w: 2048, h: 1365, alt: 'Mesa de bolo e arranjos florais em salão decorado para casamento' },
  { cdn: 'IMG_2346.webp',     local: 'IMG_2346.webp',                   w: 2048, h: 1365, alt: 'Mesas redondas montadas na área externa do Elago, entre as árvores' },
  { cdn: 'IMG_2393.webp',     local: 'IMG_2393.webp',                   w: 2048, h: 1365, alt: 'Caminho de madeira com cadeiras e arranjos de flores brancas sob as árvores' },
  { cdn: 'IMG_3339(1).webp',  local: 'IMG_3339.webp', cls: 'g-alta',   w: 1365, h: 2048, alt: 'Convidados em mesas ao ar livre durante o pôr do sol no Elago' },
  { cdn: 'IMG_3219.webp',     local: 'IMG_3219.webp', cls: 'g-grande', w: 2048, h: 1365, alt: 'Cerimônia de casamento noturna sob árvores iluminadas' },
  { cdn: 'IMG_2487.webp',     local: 'IMG_2487.webp',                   w: 2048, h: 1365, alt: 'Buffet e lanternas na área externa do Elago em evento social' },
  { cdn: 'IMG_2599.webp',     local: 'IMG_2599.webp',                   w: 2048, h: 1365, alt: 'Mesas montadas à beira do lago do Elago com lanternas penduradas' },
  { cdn: 'IMG_3312.webp',     local: 'IMG_3312.webp', cls: 'g-larga',  w: 2048, h: 1365, alt: 'Comemoração à noite na área externa do Elago, com mesas e convidados' },
  { cdn: 'IMG_5981.webp',     local: 'IMG_5981.webp',                   w: 2048, h: 1366, alt: 'Noivos no corredor branco de uma cerimônia ao ar livre no Elago' },
  { cdn: 'IMG_6006.webp',     local: 'IMG_6006.webp',                   w: 2048, h: 1365, alt: 'Salão do Elago com pista preta e decoração suspensa em formato de flores' },
];

const tiposEventoSocial = [
  { value: 'Casamento',               label: 'Casamento' },
  { value: 'Mini wedding',            label: 'Mini wedding' },
  { value: 'Aniversario',             label: 'Aniversário' },
  { value: 'Festa de 15 anos',        label: 'Festa de 15 anos' },
  { value: 'Bodas',                   label: 'Bodas' },
  { value: 'Pre wedding',             label: 'Pré wedding' },
  { value: 'Sessao de fotos',         label: 'Sessão de fotos' },
  { value: 'Confraternizacao social', label: 'Confraternização social' },
  { value: 'Outros',                  label: 'Outros' },
];
---

<Base
  title="Casamentos e Eventos Sociais em Cedral | Elago"
  description="Casamentos, aniversários e festas de 15 anos em meio à natureza, em Cedral (SP). Salão para até 700 convidados, área externa, varanda gourmet, piscina e lago. Solicite um orçamento."
  ogImage={hero.src}
  canonical="https://elago.com.br/eventos-sociais"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#1E3700" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/cwh2gwf.css" />
    <link rel="preload" href="/fonts/bangkok-sapture.otf" as="font" type="font/otf" crossorigin />
  </Fragment>

<WhatsAppWidget
  phone={config.whatsapp?.phone}
  displayName={config.whatsapp?.display_name}
  avatar={config.whatsapp?.avatar}
  submitUrl={webhookUrl}
  project={config.project_slug}
  tipoEventoOptionsCustom={tiposEventoSocial}
  tipoEventoLabel="Que tipo de celebração você quer realizar? 🥂"
/>

<!-- ===================== HEADER ===================== -->
<header class="site-header" id="cabecalho">
  <div class="wrap">
    <a class="logo" href="#topo" aria-label="Elago — voltar ao topo">
      <img src="/imagens/elago-eventos-logo.svg" alt="Elago Eventos" width="102" height="52">
    </a>
  </div>
</header>

<main>

<!-- ===================== HERO ===================== -->
<section class="hero" id="topo">
  <div class="midia-fundo">
    <img src={hero.src} data-fallback={hero.fallback} onerror={onError} alt="Vista aérea noturna do complexo Elago, com salão, piscina e áreas verdes em Cedral (SP)" width="2048" height="1594" fetchpriority="high">
  </div>
  <div class="wrap conteudo-hero">
    <h1>Celebre momentos especiais <br class="quebra-desktop">em meio à <span class="destaque">natureza</span></h1>
    <p class="sobretitulo">Casamentos <span aria-hidden="true"></span> Aniversários <span aria-hidden="true"></span> Cedral</p>
    <a class="btn btn-claro" href="#contato">Solicite orçamento</a>
  </div>
</section>

<!-- ===================== AUTORIDADE ===================== -->
<section class="autoridade" id="autoridade" aria-label="Destaques do Elago">
  <div class="wrap">
    <ul>
      <li style="--i:0"><span>De <strong><span class="contador" data-alvo="50">50</span> a <span class="contador" data-alvo="700">700</span></strong> convidados</span></li>
      <li style="--i:1"><span>Estrutura versátil</span></li>
      <li style="--i:2"><span>Integração com a natureza</span></li>
    </ul>
  </div>
</section>

<!-- ===================== CONCEITO ===================== -->
<section class="secao conceito" id="conceito">
  <div class="wrap grid-conceito">
    <div class="texto-conceito reveal">
      <span class="rotulo">Conceito</span>
      <h2 class="titulo-secao">Um espaço para comemorar do seu jeito</h2>
      <p>No Elago, cada ambiente se adapta à proposta da sua celebração. O complexo reúne salão principal, área externa, varanda gourmet, piscina e lago, oferecendo diferentes possibilidades para casamentos, aniversários e comemorações especiais, em espaços que combinam conforto, natureza e versatilidade.</p>
    </div>
    <div class="moldura-video reveal" data-atraso="1">
      <div class="video-arco">
        <video id="video-conceito" autoplay muted loop playsinline preload="metadata" poster="/imagens/elago-conceito-poster.jpg" aria-label="Vídeo institucional do Elago: fachada, salão, lago e áreas externas">
          <source src="/videos/elago-corporativo-conceito.mp4" type="video/mp4">
        </video>
        <button class="btn-som" type="button" aria-pressed="false" aria-label="Ativar som do vídeo">
          <svg class="ico-off" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.7.7 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.7.7 0 0 0 11 19.298z"/><path d="m16.5 14.5 5-5"/><path d="m16.5 9.5 5 5"/></svg>
          <svg class="ico-on" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/></svg>
          <span class="txt-som">Ativar som</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ===================== ESPAÇOS ===================== -->
<section class="secao espacos escuro" id="espacos">
  <div class="wrap">
    <div class="cabecalho-secao reveal">
      <span class="rotulo">Espaços</span>
      <h2 class="titulo-secao">Diferentes cenários para celebrar grandes momentos</h2>
    </div>

    <div class="grid-espacos">
      <article class="espaco reveal">
        <div class="arco"><img src="/imagens/elago-espaco-salao-principal.jpg" alt="Salão principal do Elago, amplo, com colunas e janelas em arco" width="1600" height="1067" loading="lazy" style="object-position:50% 50%"></div>
        <div class="numero">01</div>
        <h3>Salão principal</h3>
        <p>Com capacidade para até 700 pessoas confortavelmente ou 1.100 em formato auditório, o salão oferece diferentes possibilidades de configuração para casamentos, aniversários e grandes celebrações, com espaço para acomodar convidados e compor momentos especiais da comemoração.</p>
      </article>
      <article class="espaco reveal" data-atraso="1">
        <div class="arco"><img src="/imagens/elago-espaco-area-externa-lago.jpg" alt="Área externa do Elago vista do lago, com o salão em arcos entre as árvores" width="1672" height="941" loading="lazy" style="object-position:62% 50%"></div>
        <div class="numero">02</div>
        <h3>Área externa</h3>
        <p>Integrada à natureza e com capacidade para até 400 pessoas, a área externa é ideal para cerimônias ao ar livre, recepções e celebrações em meio ao verde.</p>
      </article>
      <article class="espaco reveal" data-atraso="2">
        <div class="arco"><img src="/imagens/elago-espaco-varanda-gourmet.jpg" alt="Varanda gourmet do Elago com piscina iluminada e espreguiçadeiras" width="1600" height="1067" loading="lazy" style="object-position:58% 50%"></div>
        <div class="numero">03</div>
        <h3>Varanda gourmet</h3>
        <p>Com capacidade para até 250 pessoas, a varanda oferece um ambiente acolhedor para aniversários, recepções e celebrações, podendo ser contratada separadamente ou integrada aos demais espaços do Elago.</p>
      </article>
      <article class="espaco reveal" data-atraso="3">
        <div class="arco"><img src="/imagens/elago-espaco-casa-exclusiva.jpg" alt="Sala de estar da casa exclusiva do Elago, com mezanino e janelas para o jardim" width="1600" height="1067" loading="lazy" style="object-position:38% 50%"></div>
        <div class="numero">04</div>
        <h3>Casa exclusiva</h3>
        <p>Com acomodação para até 12 pessoas, a casa oferece conforto e privacidade para anfitriões e convidados, sendo um espaço de apoio durante a celebração.</p>
      </article>
    </div>
    <p class="dica-arraste" aria-hidden="true">Arraste para ver os ambientes</p>
  </div>
</section>

<!-- ===================== EVENTOS ===================== -->
<section class="secao eventos" id="eventos">
  <div class="wrap">
    <div class="cabecalho-secao reveal">
      <span class="rotulo">Eventos</span>
      <h2 class="titulo-secao">Versatilidade para diferentes comemorações</h2>
    </div>
    <ul class="grid-eventos">
      <li class="evento reveal">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span>
        <span>Casamentos</span>
      </li>
      <li class="evento reveal" data-atraso="1">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="15" r="5"/><circle cx="15" cy="15" r="5"/><path d="m10 4 2-2 2 2-2 3z"/></svg></span>
        <span>Mini weddings</span>
      </li>
      <li class="evento reveal" data-atraso="2">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/></svg></span>
        <span>Aniversários</span>
      </li>
      <li class="evento reveal" data-atraso="3">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg></span>
        <span>Festas de 15 anos</span>
      </li>
      <li class="evento reveal">
        <span class="icone-evento"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg></span>
        <span>Bodas</span>
      </li>
    </ul>
  </div>
</section>

<!-- ===================== DEPOIMENTOS ===================== -->
<section class="secao depoimentos" id="depoimentos">
  <div class="wrap">
    <div class="topo-depoimentos">
      <div class="reveal">
        <span class="rotulo">Depoimentos</span>
        <h2 class="titulo-secao">O Elago pela experiência de quem esteve aqui</h2>
      </div>
      <a class="nota-google reveal" data-atraso="1" href="https://www.google.com/search?q=elago+eventos#lrd=0x94bc4b7722753c41:0xeb4dac9086f68dc4,1" target="_blank" rel="noopener">
        <span class="valor">4,9</span>
        <span class="detalhe">
          <span class="estrelas" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            <svg viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
          </span>
          Nota no Google
        </span>
      </a>
    </div>

    <div class="carrossel reveal" data-atraso="1">
      <div class="trilho" id="trilho-depoimentos" tabindex="0" aria-label="Depoimentos de clientes no Google">
        <figure class="depoimento">
          <svg class="aspas" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg>
          <blockquote>Estrutura linda e planejada para todos os tipos de eventos. Paisagens única</blockquote>
          <footer><span class="avatar" aria-hidden="true">A</span><span class="quem"><strong>Andre Saraiva</strong><span>Avaliação no Google</span></span></footer>
        </figure>
        <figure class="depoimento">
          <svg class="aspas" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg>
          <blockquote>Lugar maravilhoso pra eventos de todos os tipos, localização excelente, fácil acesso, super recomendo.</blockquote>
          <footer><span class="avatar" aria-hidden="true">R</span><span class="quem"><strong>Rodrigo Reis</strong><span>Avaliação no Google</span></span></footer>
        </figure>
        <figure class="depoimento">
          <svg class="aspas" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg>
          <blockquote>Lugar muito lindo, estrutura boa, ambiente climatizado, passei horas muito agradáveis neste local, e o lago é muito bonito.</blockquote>
          <footer><span class="avatar" aria-hidden="true">L</span><span class="quem"><strong>Leonardo Destefani</strong><span>Avaliação no Google</span></span></footer>
        </figure>
        <figure class="depoimento">
