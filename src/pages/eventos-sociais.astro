<!-- Lightbox da galeria -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Galeria de fotos do Elago" hidden>
  <span class="lb-contador" id="lb-contador"></span>
  <button class="lb-fechar" type="button" aria-label="Fechar galeria"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
  <figure>
    <img id="lb-imagem" src="" alt="">
  </figure>
</div>

<script>
  import { initForms } from '../scripts/forms';
  document.addEventListener('DOMContentLoaded', initForms);
</script>

<script is:inline>
(function(){
  var reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Header muda ao rolar */
  var header = document.getElementById('cabecalho');
  function atualizaHeader(){ header.classList.toggle('rolado', window.scrollY > 40); }
  atualizaHeader();
  window.addEventListener('scroll', atualizaHeader, {passive:true});

  /* Animações de entrada */
  var revelaveis = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !reduzMovimento){
    var io = new IntersectionObserver(function(entradas){
      entradas.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('visivel'); io.unobserve(e.target); } });
    }, {rootMargin:'0px 0px -8% 0px', threshold:0.08});
    revelaveis.forEach(function(el){ io.observe(el); });
  } else {
    revelaveis.forEach(function(el){ el.classList.add('visivel'); });
  }

  /* Autoridade: linhas, entrada escalonada e contagem dos números */
  var autoridade = document.getElementById('autoridade');
  if (autoridade){
    var contadores = autoridade.querySelectorAll('.contador');
    var formata = function(n){ return n.toLocaleString('pt-BR'); };
    var anima = function(){
      autoridade.classList.add('animado');
      contadores.forEach(function(c){
        var alvo = Number(c.dataset.alvo);
        if (reduzMovimento){ c.textContent = formata(alvo); return; }
        var inicio = null, dur = 1800;
        c.textContent = '0';
        var passo = function(t){
          if (!inicio) inicio = t;
          var pr = Math.min((t - inicio) / dur, 1);
          var suave = 1 - Math.pow(1 - pr, 3);
          c.textContent = formata(Math.round(alvo * suave));
          if (pr < 1) requestAnimationFrame(passo);
        };
        setTimeout(function(){ requestAnimationFrame(passo); }, 450);
      });
    };
    if ('IntersectionObserver' in window && !reduzMovimento){
      var ioAut = new IntersectionObserver(function(en){
        if (en[en.length-1].isIntersecting){ anima(); ioAut.disconnect(); }
      }, {threshold:0.35});
      ioAut.observe(autoridade);
    } else { anima(); }
  }

  /* Vídeo do conceito: som e pausa fora da tela */
  var video = document.getElementById('video-conceito');
  var btnSom = document.querySelector('.btn-som');
  if (video && btnSom){
    if (reduzMovimento){ video.removeAttribute('autoplay'); video.pause(); }
    btnSom.addEventListener('click', function(){
      var ligar = video.muted;
      video.muted = !ligar;
      if (ligar && video.paused){ video.play(); }
      btnSom.setAttribute('aria-pressed', String(ligar));
      btnSom.setAttribute('aria-label', ligar ? 'Desativar som do vídeo' : 'Ativar som do vídeo');
      btnSom.querySelector('.txt-som').textContent = ligar ? 'Som ativado' : 'Ativar som';
    });
    if ('IntersectionObserver' in window && !reduzMovimento){
      new IntersectionObserver(function(entradas){
        entradas.forEach(function(e){
          if (e.isIntersecting){ var p = video.play(); if (p && p.catch) p.catch(function(){}); }
          else { video.pause(); }
        });
      }, {threshold:0.25}).observe(video);
    }
  }

  /* Carrossel de depoimentos: avança sozinho (sem setas); pausa ao passar o mouse ou tocar */
  var trilho = document.getElementById('trilho-depoimentos');
  if (trilho && !reduzMovimento){
    var passo = function(){ var c = trilho.querySelector('.depoimento'); return c ? c.getBoundingClientRect().width + 24 : 300; };
    var timer = null, pausado = false;
    var avanca = function(){
      if (pausado) return;
      var max = trilho.scrollWidth - trilho.clientWidth - 2;
      if (trilho.scrollLeft >= max) trilho.scrollTo({left:0, behavior:'smooth'});
      else trilho.scrollBy({left: passo(), behavior:'smooth'});
    };
    var inicia = function(){ if (!timer) timer = setInterval(avanca, 5000); };
    var para = function(){ clearInterval(timer); timer = null; };
    ['mouseenter','focusin','touchstart'].forEach(function(ev){ trilho.addEventListener(ev, function(){ pausado = true; }, {passive:true}); });
    ['mouseleave','focusout','touchend'].forEach(function(ev){ trilho.addEventListener(ev, function(){ setTimeout(function(){ pausado = false; }, 2500); }, {passive:true}); });
    if ('IntersectionObserver' in window){
      new IntersectionObserver(function(en){ en[en.length-1].isIntersecting ? inicia() : para(); }, {threshold:0.3}).observe(trilho);
    } else { inicia(); }
  }

  /* Galeria: pontos do carrossel (celular) + lightbox */
  var grid = document.getElementById('grid-galeria');
  var pontos = document.getElementById('pontos-galeria');
  if (grid && pontos){
    var fotos = grid.querySelectorAll('.g-item');
    fotos.forEach(function(f, i){
      var b = document.createElement('button');
      b.type = 'button'; b.tabIndex = -1;
      b.addEventListener('click', function(){ grid.scrollTo({left: f.offsetLeft - (grid.clientWidth - f.clientWidth) / 2, behavior:'smooth'}); });
      pontos.appendChild(b);
    });
    var marcaPonto = function(){
      var centro = grid.scrollLeft + grid.clientWidth / 2, melhor = 0, dist = Infinity;
      fotos.forEach(function(f, i){ var d = Math.abs(f.offsetLeft + f.clientWidth / 2 - centro); if (d < dist){ dist = d; melhor = i; } });
      pontos.querySelectorAll('button').forEach(function(b, i){ b.classList.toggle('ativo', i === melhor); });
    };
    grid.addEventListener('scroll', marcaPonto, {passive:true});
    window.addEventListener('resize', marcaPonto);
    marcaPonto();
  }

  var itens = Array.prototype.slice.call(document.querySelectorAll('.g-item'));
  var lb = document.getElementById('lightbox');
  var lbImg = document.getElementById('lb-imagem');
  var lbContador = document.getElementById('lb-contador');
  var atual = 0, ultimoFoco = null;
  function mostra(i){
    atual = (i + itens.length) % itens.length;
    var img = itens[atual].querySelector('img');
    lbImg.src = img.getAttribute('src');
    lbImg.alt = img.alt;
    lbContador.textContent = (atual + 1) + ' / ' + itens.length;
  }
  function abre(i){ ultimoFoco = document.activeElement; mostra(i); lb.hidden = false; document.body.style.overflow = 'hidden'; lb.querySelector('.lb-fechar').focus(); }
  function fecha(){ lb.hidden = true; document.body.style.overflow = ''; if (ultimoFoco) ultimoFoco.focus(); }
  itens.forEach(function(item, i){ item.setAttribute('aria-label', 'Ampliar foto: ' + item.querySelector('img').alt); item.addEventListener('click', function(){ abre(i); }); });
  lb.querySelector('.lb-fechar').addEventListener('click', fecha);
  lbImg.addEventListener('click', function(e){
    var r = lbImg.getBoundingClientRect();
    mostra(atual + ((e.clientX - r.left) < r.width / 3 ? -1 : 1));
  });
  lb.addEventListener('click', function(e){ if (e.target === lb) fecha(); });
  document.addEventListener('keydown', function(e){
    if (lb.hidden) return;
    if (e.key === 'Escape') fecha();
    if (e.key === 'ArrowLeft') mostra(atual - 1);
    if (e.key === 'ArrowRight') mostra(atual + 1);
  });
  var toqueX = null;
  lb.addEventListener('touchstart', function(e){ toqueX = e.touches[0].clientX; }, {passive:true});
  lb.addEventListener('touchend', function(e){
    if (toqueX === null) return;
    var dx = e.changedTouches[0].clientX - toqueX;
    if (Math.abs(dx) > 50) mostra(atual + (dx < 0 ? 1 : -1));
    toqueX = null;
  });

  /* CTA fixo no celular: aparece depois do hero e some no formulário */
  var cta = document.getElementById('cta-movel');
  if (cta && 'IntersectionObserver' in window){
    var heroVisivel = true, contatoVisivel = false;
    function atualizaCta(){ cta.classList.toggle('ativo', !heroVisivel && !contatoVisivel); }
    new IntersectionObserver(function(en){ heroVisivel = en[en.length-1].isIntersecting; atualizaCta(); }, {threshold:0.15}).observe(document.getElementById('topo'));
    new IntersectionObserver(function(en){ contatoVisivel = en[en.length-1].isIntersecting; atualizaCta(); }, {threshold:0.1}).observe(document.getElementById('contato'));
  }

  /* Ano no rodapé */
  var ano = document.getElementById('ano');
  if (ano) ano.textContent = new Date().getFullYear();
})();
</script>

</Base>
