<section class="secao contato bege" id="contato">
  <svg class="fachada" viewBox="0 0 1200 260" fill="none" stroke-width="1.4" aria-hidden="true">
    <path d="M20 40h1160M36 52h1128M36 40v12M1164 40v12M60 60h1080M60 52v8M1140 52v8"/>
    <path d="M80 60v200M1120 60v200"/>
    <path d="M150 260V170a40 40 0 0 1 80 0v90M300 260V180a34 34 0 0 1 68 0v80M400 260V180a34 34 0 0 1 68 0v80"/>
    <path d="M540 260V150h22v-14a38 38 0 0 1 76 0v14h22v110"/>
    <path d="M732 260V180a34 34 0 0 1 68 0v80M832 260V180a34 34 0 0 1 68 0v80M970 260V170a40 40 0 0 1 80 0v90"/>
  </svg>

  <div class="wrap grid-contato">
    <div class="texto-contato reveal">
      <span class="rotulo">Contato</span>
      <h2 class="titulo-secao">Vamos planejar sua próxima celebração?</h2>
      <p>Preencha o formulário e receba um atendimento personalizado para conhecer nosso espaço, esclarecer dúvidas e solicitar um orçamento.</p>
    </div>

    <form class="form-contato reveal" data-atraso="1" id="form-orcamento" method="post"
      data-form-id="form-orcamento"
      data-submit-url={webhookUrl}
      data-project="elago"
      data-grid-id="form-orcamento"
      data-success-id="form-orcamento-ok"
    >
      <div class="campo">
        <label for="nome">Nome</label>
        <input id="nome" name="nome" type="text" autocomplete="name" required>
      </div>
      <div class="campo">
        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(17) 99999-9999" required>
      </div>
      <div class="campo">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="campo inteiro">
        <label for="tipo_evento">Tipo de celebração</label>
        <select id="tipo_evento" name="tipo_evento" required>
          <option value="" disabled selected>Selecione o tipo de celebração</option>
          <option value="Casamento">Casamento</option>
          <option value="Mini wedding">Mini wedding</option>
          <option value="Aniversario">Aniversário</option>
          <option value="Festa de 15 anos">Festa de 15 anos</option>
          <option value="Bodas">Bodas</option>
          <option value="Pre wedding">Pré wedding</option>
          <option value="Sessao de fotos">Sessão de fotos</option>
          <option value="Confraternizacao social">Confraternização social</option>
          <option value="Outros">Outros</option>
        </select>
      </div>
      <div class="campo">
        <label for="data_evento">Data da celebração</label>
        <input id="data_evento" name="data_evento" type="text" data-datepicker autocomplete="off" placeholder="dd/mm/aaaa" required>
      </div>
      <div class="campo">
        <label for="convidados">Número de convidados</label>
        <input id="convidados" name="convidados" type="number" inputmode="numeric" min="1" step="1" placeholder="Ex.: 150" required>
      </div>
      <div class="campo inteiro">
        <label for="detalhes_adicionais">Detalhes da celebração <span class="hint">(não obrigatório)</span></label>
        <textarea id="detalhes_adicionais" name="detalhes_adicionais" rows="3" placeholder="Conte um pouco mais sobre a sua celebração"></textarea>
      </div>
      <input type="text" name="website" tabindex="-1" style="display:none;position:absolute" aria-hidden="true" autocomplete="off">
      <button class="btn btn-escuro" type="submit">Solicitar Orçamento</button>
      <p class="aviso">Seus dados serão usados apenas para o retorno da equipe Elago.</p>
    </form>

    <div id="form-orcamento-ok" hidden style="grid-column:2">
      <h3 style="font-family:var(--fonte-titulo);font-size:clamp(24px,3vw,36px);color:var(--cor-verde)">Mensagem enviada!</h3>
      <p style="color:var(--cor-texto)">Em breve nossa equipe entrará em contato para apresentar o espaço e enviar o orçamento.</p>
    </div>
  </div>
</section>

