          <button class={`g-item${g.cls ? ' ' + g.cls : ''}`} type="button">
            <img src={f.src} data-fallback={f.fallback} onerror={onError} alt={g.alt} loading="lazy" width={g.w} height={g.h} />
          </button>
        );
